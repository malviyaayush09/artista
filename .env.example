# Names only. Never commit real values. Razorpay stays in TEST mode during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. orders@artistacakes.in. Empty = Resend test sender.
EMAIL_FROM=
# WhatsApp Cloud API (Meta). Leave empty to keep WhatsApp off. See docs/whatsapp-setup.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Daily reminder emails (vercel.json cron). Any long random string; Vercel sends it as a Bearer token.
CRON_SECRET=

# Public base URL (not a secret). Used for sitemap, OG tags and links in emails.
SITE_URL=
